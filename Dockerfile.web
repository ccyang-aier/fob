FROM node:24-bookworm-slim AS build
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY shared/package.json ./shared/package.json
COPY backend/server/package.json ./backend/server/package.json
RUN pnpm install --frozen-lockfile --ignore-scripts
COPY . .
ARG NEXT_PUBLIC_FOB_API_URL
ENV NEXT_PUBLIC_FOB_API_URL=$NEXT_PUBLIC_FOB_API_URL
RUN test -n "$NEXT_PUBLIC_FOB_API_URL" && pnpm build

FROM nginx:1.28-alpine
COPY scripts/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/out /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=5s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1
