# Fob development setup: pnpm dev:init (generates independent ignored secrets).
# For managed production, provide environment variables directly to each service.
FOB_WEB_PORT=3001
FOB_SERVICE_HOST=127.0.0.1
FOB_SERVICE_PORT=8721
FOB_DEV_WORKER=1
NEXT_PUBLIC_FOB_API_URL=http://127.0.0.1:8721
ROLE=api,collab,mcp

# Use independent Fob database credentials. The application role must be
# NOSUPERUSER/NOBYPASSRLS and must not own the business tables.
FOB_POSTGRES_USER=fob_admin
FOB_POSTGRES_DB=fob
FOB_POSTGRES_PASSWORD=replace-with-unique-admin-secret
FOB_DATABASE_APP_PASSWORD=replace-with-unique-runtime-secret
DATABASE_ADMIN_URL=postgresql://fob_admin:replace-with-unique-admin-secret@127.0.0.1:55433/fob
DATABASE_URL=postgresql://fob_app:replace-with-unique-runtime-secret@127.0.0.1:55433/fob

# Auth cookies use the Fob prefix. Production origins and callback URL use HTTPS.
BETTER_AUTH_URL=http://127.0.0.1:8721
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
FOB_AUTH_TRUSTED_ORIGINS=http://127.0.0.1:3001,http://localhost:3001,http://127.0.0.1:8721,http://localhost:8721
FOB_AUTH_COOKIE_MODE=same-site

KNOWLEDGE_REDIS_PASSWORD=replace-with-unique-redis-secret
REDIS_URL=redis://:replace-with-unique-redis-secret@127.0.0.1:56380
S3_ENDPOINT=http://127.0.0.1:59010
S3_REGION=us-east-1
S3_BUCKET=fob-knowledge
S3_ACCESS_KEY_ID=replace-with-unique-storage-id
S3_SECRET_ACCESS_KEY=replace-with-unique-storage-secret

# The worker is optional until media processing is needed; API/editor remain
# separate. Use the same token in the business worker and Python media worker.
MEDIA_WORKER_URL=http://127.0.0.1:8920
MEDIA_WORKER_TOKEN=replace-with-at-least-32-random-characters
MEDIA_WORKER_DOWNLOAD_ORIGINS=http://127.0.0.1:59010

# Optional models (no model credentials are copied from Fouc).
# KNOWLEDGE_AI_API_KEY=
# KNOWLEDGE_AI_CHAT_BASE_URL=https://your-provider.example/v1
# KNOWLEDGE_AI_MODEL=
# KNOWLEDGE_AI_VISION_MODEL=
# KNOWLEDGE_AI_EMBED_MODEL=
# KNOWLEDGE_AI_EMBED_DIMENSIONS=1024
# KNOWLEDGE_AI_OLLAMA_ENDPOINT=http://127.0.0.1:11434

# Optional email and OAuth. Without SMTP, development verification URLs go to
# this product's own server log. Configure your own provider callback URLs.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# FOB_AUTH_PROVIDERS=[{"kind":"oidc","id":"company","name":"Company","clientId":"...","clientSecret":"...","issuer":"https://identity.example.com"}]

# Production Compose: set all values above plus external public origins.
# FOB_PUBLIC_WEB_ORIGIN=https://book.example.com
# FOB_PUBLIC_S3_ORIGIN=https://files.book.example.com
