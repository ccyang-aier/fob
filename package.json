{
  "name": "fob",
  "version": "0.1.0",
  "private": true,
  "description": "Fob (Fusion One Book) — an independent Web knowledge and collaboration platform.",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3001",
    "dev:all": "node scripts/dev.mjs",
    "build": "next build",
    "preview": "serve out --listen 3001",
    "start": "serve out --listen 3001",
    "dev:init": "node scripts/init-development.mjs",
    "infra:init": "node backend/server/scripts/knowledge-infra.mjs init",
    "infra:up": "node backend/server/scripts/knowledge-infra.mjs up",
    "infra:status": "node backend/server/scripts/knowledge-infra.mjs status",
    "database:init": "bun --env-file=.env.fob.local backend/server/scripts/database.ts init",
    "database:status": "bun --env-file=.env.fob.local backend/server/scripts/database.ts status",
    "knowledge:jobs:init": "bun --env-file=.env.fob.local backend/server/scripts/knowledge-jobs.ts init",
    "server:dev": "bun --watch --env-file=.env.fob.local backend/server/src/entrypoints/server.ts",
    "server:start": "bun backend/server/src/entrypoints/server.ts",
    "server:typecheck": "pnpm --filter @fob/server typecheck",
    "server:test": "pnpm --filter @fob/server test",
    "server:build": "pnpm --filter @fob/server build",
    "worker:start": "bun backend/server/src/entrypoints/worker.ts",
    "backend:typecheck": "pnpm server:typecheck",
    "backend:test": "pnpm server:test",
    "shared:typecheck": "tsc --noEmit -p shared/tsconfig.json",
    "shared:test": "bun test --isolate ./shared/src/knowledge",
    "knowledge:test": "bun test --isolate ./shared/src/knowledge ./src/features/knowledge ./backend/server/src/modules/knowledge",
    "knowledge:verify": "node scripts/verify-extraction.mjs",
    "architecture:verify": "node scripts/verify-extraction.mjs",
    "i18n:verify": "node scripts/verify-i18n.mjs",
    "lint": "eslint . --max-warnings=0",
    "check": "pnpm typecheck && pnpm server:typecheck && pnpm shared:typecheck && pnpm architecture:verify && pnpm i18n:verify && pnpm lint && pnpm build",
    "test:frontend": "bun test --isolate ./src",
    "typecheck": "tsc --noEmit",
    "storage:init": "bun --env-file=.env.fob.local scripts/initialize-storage.mjs",
    "worker:dev": "bun --watch --env-file=.env.fob.local backend/server/src/entrypoints/worker.ts",
    "media:dev": "node scripts/media-worker.mjs"
  },
  "dependencies": {
    "@aiden0z/pptx-renderer": "1.3.0",
    "@fob/shared": "workspace:*",
    "@hocuspocus/provider": "4.7.0",
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-dropdown-menu": "latest",
    "@radix-ui/react-slot": "latest",
    "@radix-ui/react-tooltip": "latest",
    "@tanstack/react-query": "5.104.0",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-bubble-menu": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@trpc/client": "11.19.0",
    "class-variance-authority": "latest",
    "client-only": "0.0.1",
    "clsx": "latest",
    "docx-preview": "0.4.1",
    "highlight.js": "^11.12.0",
    "katex": "0.16.47",
    "lucide-react": "1.55.0",
    "motion": "^13.2.0",
    "next": "16.3.3",
    "pdfjs-dist": "6.3.289",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "latest",
    "y-indexeddb": "9.0.12",
    "y-prosemirror": "1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@fob/server": "workspace:*",
    "@tailwindcss/postcss": "4.3.3",
    "@types/katex": "0.16.8",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/ws": "^8.18.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "^20.14.5",
    "lib0": "^0.2.118",
    "postcss": "latest",
    "serve": "latest",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "latest",
    "typescript": "5.9.3",
    "ws": "^8.21.3"
  },
  "pnpm": {}
}
