{
  "name": "@fob/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/entrypoints/server.ts",
  "scripts": {
    "pdf:prepare": "node scripts/prepare-document-pdf.mjs",
    "dev": "bun --watch --env-file=../../.env.fob.local --env-file=../../.env.knowledge.models.local src/entrypoints/server.ts",
    "start": "bun src/entrypoints/server.ts",
    "typecheck": "tsc --noEmit",
    "models:catalog": "bun scripts/models-catalog.ts",
    "test": "bun test src",
    "build": "bun build --target=bun --packages=external ./src/entrypoints/server.ts ./src/entrypoints/worker.ts --outdir dist",
    "worker:start": "bun src/entrypoints/worker.ts",
    "worker:dev": "bun --watch --env-file=../../.env.fob.local src/entrypoints/worker.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.65",
    "@ai-sdk/cohere": "4.0.50",
    "@ai-sdk/openai-compatible": "3.0.57",
    "@better-auth/drizzle-adapter": "1.7.6",
    "@fob/shared": "workspace:*",
    "@hocuspocus/extension-redis": "4.7.0",
    "@hocuspocus/server": "^4.7.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.11.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@trpc/server": "11.19.0",
    "ai": "7.0.116",
    "better-auth": "1.7.6",
    "crossws": "^0.4.12",
    "drizzle-orm": "0.45.3",
    "fflate": "0.8.2",
    "graphile-worker": "0.18.0",
    "hono": "^4.13.5",
    "ioredis": "5.6.1",
    "jose": "6.2.10",
    "node-html-parser": "^9.0.4",
    "nodemailer": "10.0.10",
    "pg": "8.23.0",
    "puppeteer": "25.12.0",
    "remark-directive": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "y-protocols": "^1.0.7",
    "yaml": "2.8.1",
    "yjs": "13.6.33",
    "zod": "4.6.5",
    "@better-auth/utils": "0.4.2",
    "@tiptap/pm": "3.31.3"
  },
  "devDependencies": {
    "@trpc/client": "11.19.0",
    "@types/bun": "^1.4.0",
    "@types/mdast": "4.0.4",
    "@types/pg": "8.23.1",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "0.31.11",
    "typescript": "5.9.3",
    "ws": "^8.21.3"
  },
  "exports": {
    "./knowledge-api": {
      "types": "./src/modules/knowledge/api/client-types.ts"
    }
  }
}
